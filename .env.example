# Client environment variables
# Local: copy to .env.local — Vercel: set in Project Settings → Environment Variables

# Base URL of the Express server, no trailing slash.
# Used only by next.config.mjs as the rewrite proxy target — every API request
# goes through this client domain (same-origin) so the auth cookie is stored here.
# Local:  http://localhost:5000
# Vercel: https://your-server-project.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
